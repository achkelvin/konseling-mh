# Salin menjadi .env lalu isi.

# --- Email (SMTP) ---
# Kosongkan NUXT_SMTP_HOST saat pengembangan: email akan disimpan ke folder .outbox/
# Contoh Gmail: host smtp.gmail.com, port 465, user = alamat Gmail,
# pass = App Password (bukan password akun) dari myaccount.google.com/apppasswords
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=465
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
NUXT_SMTP_FROM="KonselingMH <alamat@domainmu.com>"

# Alamat yang menerima setiap formulir pendaftaran
NUXT_ADMIN_EMAIL=

# --- Pembayaran QRIS ---
# Isi dengan teks hasil scan QRIS statis merchant kamu (diawali 000201...).
# Situs akan otomatis menambahkan nominal ke QR. Kosong = QR contoh (tidak bisa dibayar).
NUXT_PUBLIC_QRIS_PAYLOAD=

# --- Pembayaran (transfer bank) ---
# Bawaan: Bank Mandiri 1770011516751 a/n Nadiah Cahyani. Isi untuk mengganti.
# NUXT_PUBLIC_BANK_NAME=
# NUXT_PUBLIC_BANK_ACCOUNT=
# NUXT_PUBLIC_BANK_HOLDER=

# Nomor WhatsApp admin untuk konfirmasi pembayaran
NUXT_PUBLIC_WHATSAPP_NUMBER=081234567890
